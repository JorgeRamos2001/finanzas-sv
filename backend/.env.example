# =============================================================================
#  FinanzasSV - Variables de entorno del backend
#  Copia este archivo como ".env" y ajusta los valores de tu entorno local.
#  El archivo .env NO se sube al repositorio (esta en .gitignore).
# =============================================================================

# --- Servidor -----------------------------------------------------------------
# Puerto de la API REST
SERVER_PORT=8080

# --- Base de datos PostgreSQL ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finanzas_sv
DB_USER=postgres
DB_PASSWORD=postgres

# --- Seguridad (FASE 2: JWT) ----------------------------------------------------
# Secret para firmar los tokens JWT (usar una cadena larga y aleatoria en produccion)
JWT_SECRET=finanzas-sv-secreto-demo-cambiar-en-produccion
# Vigencia del token en milisegundos (8 horas)
JWT_EXPIRATION_MS=28800000
